# Copy to panel.env and fill in. Generate every secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The password hash MUST be base64-encoded: Docker Compose interpolates `$` in
# env_file values, which silently truncates a raw pbkdf2 hash into nonsense.
#   python3 -c "import base64,sys; sys.path.insert(0,'.'); \
#     from core.auth import hash_password; \
#     print(base64.b64encode(hash_password('your-password').encode()).decode())"

PORT=8100
BIND=0.0.0.0
LAN_ONLY=true

# First-run admin. Created only when the database has no users.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me

SESSION_SECRET=
STATUS_TXT_TOKEN=

SUPERVISOR_URL=http://127.0.0.1:8088
SUPERVISOR_USER=admin
SUPERVISOR_PASS=
SUPERVISOR_PROGRAM=valheim-server

RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

AGENT_URL=http://127.0.0.1:2456
AGENT_TOKEN=

CONFIG_DIR=/config
PROBE_FILE=/config/cache/hostprobe.json
GAME_TZ=Asia/Jakarta
DB_FILE=/config/cache/panel.db
